[Unit]
Description=XMQR MQTT bridge (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/xmqr-client/bridge-%i.toml
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=xmqr-client
Group=xmqr-client
ExecStart=/usr/bin/mqtt-bridge --config /etc/xmqr-client/bridge-%i.toml
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
